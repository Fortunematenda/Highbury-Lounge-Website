upstream highbury_lounge_web {
  server 127.0.0.1:8095;
  keepalive 16;
}

server {
  listen 80;
  listen [::]:80;
  server_name highbury-lounge.co.zw www.highbury-lounge.co.zw;

  location /.well-known/acme-challenge/ {
    root /var/www/html;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  server_name highbury-lounge.co.zw www.highbury-lounge.co.zw;
  client_max_body_size 50m;

  ssl_certificate /etc/letsencrypt/live/highbury-lounge.co.zw/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/highbury-lounge.co.zw/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  location / {
    proxy_pass http://highbury_lounge_web;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 120s;
  }
}
